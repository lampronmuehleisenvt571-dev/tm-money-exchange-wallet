# TM Money Exchange Wallet - Environment Configuration
# Copy this file to .env and fill in your values

# ==================== APPLICATION ====================
APP_NAME=tm-money-exchange
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_PORT=8080
APP_LOG_LEVEL=info

# ==================== SECURITY ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=your-encryption-key-32-chars-long
HSM_ENABLED=false

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=tm_money
DB_PASSWORD=secure_password_change_me
DB_NAME=tm_money_production
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=100

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tm_money_logs

# Elasticsearch
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=elastic_password

# ==================== MESSAGE QUEUES ====================
KAFKA_BROKERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==================== BLOCKCHAIN ====================
BTC_NODE_URL=http://localhost:8332
BTC_NETWORK=testnet
ETH_NODE_URL=http://localhost:8545
ETH_CHAIN_ID=5
ETH_NETWORK=goerli
TRON_NODE_URL=http://localhost:8090
BNB_NODE_URL=https://data-seed-prebsc-1-b.binance.org:8545
SOL_RPC_URL=https://api.devnet.solana.com
POLYGON_NODE_URL=https://rpc-mumbai.maticvigil.com

# ==================== COMPLIANCE ====================
KYC_LEVEL_MIN=1
AML_SCREENING_ENABLED=true
AML_THRESHOLD_DAILY=50000

# ==================== TRADING ====================
DEFAULT_MAKER_FEE_PERCENT=0.10
DEFAULT_TAKER_FEE_PERCENT=0.15
MIN_ORDER_SIZE=0.001
MAX_ORDER_SIZE=1000000

# ==================== MONITORING ====================
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
JAEGER_AGENT_HOST=localhost

# ==================== FEATURE FLAGS ====================
FEATURE_P2P_TRADING=true
FEATURE_AGENT_NETWORK=false
FEATURE_INTERNATIONAL_REMITTANCE=true
FEATURE_NFT_MARKETPLACE=false
FEATURE_STAKING=true

# ==================== DEVELOPMENT ====================
DEVELOPMENT_MODE=true
DEBUG_LOGGING=true
